# ==============================================================================
# Career Agents - environment configuration
# Copy this file to ".env" and fill in only the keys you want to use.
# Everything here has a FREE tier. You do NOT need all of them.
# ==============================================================================

# ---- Which LLM provider to use by default ----
# Options: groq | gemini | ollama | openrouter
LLM_PROVIDER=groq

# ---- Groq (free tier, very fast) -> https://console.groq.com/keys ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Google Gemini (free tier) -> https://aistudio.google.com/apikey ----
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- OpenRouter (has free models) -> https://openrouter.ai/keys ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---- Ollama (100% free & local, no key) -> https://ollama.com ----
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# ==============================================================================
# LinkedIn - OFFICIAL API ONLY (posting uses the approved REST API).
# Create an app at https://www.linkedin.com/developers/apps
# Request the "Share on LinkedIn" (w_member_social) product.
# ==============================================================================
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:XXXXXXXX

# ==============================================================================
# Your profile data (used by agents to draft content, cover letters, etc.)
# ==============================================================================
PROFILE_PATH=./config/profile.json
